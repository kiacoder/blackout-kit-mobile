<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is blocked by default (targetSdk 34) except on loopback, which the
  app needs because the bundled engine exposes its SOCKS/HTTP proxy on 127.0.0.1
  and the Dart health checks talk to it over plain HTTP.
  Remote config sources (raw.githubusercontent.com and friends) stay HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.111.222.1</domain>
    </domain-config>
</network-security-config>
