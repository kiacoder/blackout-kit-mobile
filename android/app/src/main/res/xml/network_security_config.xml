<?xml version="1.0" encoding="utf-8"?>
<!--
  Android HTTP clients must use TLS for all destinations. The engine's
  loopback SOCKS transport uses raw sockets, not an HTTP URL exception.
  This policy is not a firewall for native engine traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
